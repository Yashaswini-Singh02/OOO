NEATLOGS_API_KEY=nl_...
OPENROUTER_API_KEY=sk-or-...
# OpenRouter model id for the scout call; defaults to anthropic/claude-haiku-5.5
# OO_MODEL=anthropic/claude-haiku-5.5
# 1 = tools read from fixtures/, 0 = real providers
OO_FIXTURES=1
# Live providers, used when OO_FIXTURES=0
GOOGLE_API_KEY=...
TAVILY_API_KEY=tvly-...
# Daily caps on paid calls; the tools return nothing once a cap is reached
# OO_TAVILY_DAILY_CAP=30
# OO_GOOGLE_DAILY_CAP=200
# OO_YOUTUBE_DAILY_CAP=50
# WhatsApp through Meta's WhatsApp Cloud API (python -m app.whatsapp)
META_ACCESS_TOKEN=...
META_PHONE_NUMBER_ID=...
META_APP_SECRET=...
# any string you choose; you type the same one into the webhook form
META_VERIFY_TOKEN=...
# the Graph API version shown in your app's sample request
# META_GRAPH_VERSION=v23.0
# Or WhatsApp through the Twilio sandbox; its webhook path is /twilio
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# the public https address of your tunnel, without a trailing slash or path
# PUBLIC_URL=https://your-tunnel.example
# Telegram bot (python -m app.telegram); the token comes from @BotFather
TELEGRAM_BOT_TOKEN=...
# optional: comma-separated chat ids allowed to use the bot; unset means anyone
# TELEGRAM_ALLOWED_CHATS=123456789
